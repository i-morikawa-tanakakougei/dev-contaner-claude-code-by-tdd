        {
          "condition": "subagent_completed",
          "action": "update_subagent_metrics",
          "target_files": ["project-context.json", "project-state.json"]
        },
        {
          "condition": "health_check_required",
          "action": "recalculate_health_scores",
          "target_files": ["project-state.json", "system-integration.json"]
        }
      ]
    },
    "health_monitoring": {
      "enabled": true,
      "monitoring_interval": "300s",
      "alert_thresholds": {
        "system_availability": 95,
        "data_consistency": 98,
        "performance_degradation": 20
      },
      "auto_recovery": {
        "enabled": true,
        "recovery_procedures": [
          {
            "condition": "context_file_corrupted",
            "action": "restore_from_backup"
          },
          {
            "condition": "metadata_inconsistency",
            "action": "trigger_manual_sync_guide"
          }
        ]
      }
    }

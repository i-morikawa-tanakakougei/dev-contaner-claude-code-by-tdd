      "criteria": [
        "Core scenarios documented",
        "Minor formatting improvements needed",
        "Traceability mostly maintained"
      ]
    },
    "rejected": {
      "description": "Major Issues Require Rework",
      "criteria": [
        "Feedback analysis incomplete",
        "Scenarios poorly documented",
        "Missing Given-When-Then structure",
        "Traceability lost"
      ]
    }
  },
  "next_steps": {
    "approved": "Integrate scenarios into /sprint-planning",
    "conditional_approval": "Apply improvements then integrate scenarios",
    "rejected": "/evolve-scenarios (rework required)"
  },
  "retry_context": {
    "focus_areas": [
      "Thorough feedback analysis and extraction",
      "Clear Given-When-Then scenario structure",

{
  "command": "05.5-review-test-design",
  "description": "TDD test design quality and Given-When-Then scenario coverage review",
  "phase": "test-design-review",
  "critical_tasks": [
    "tdd_red_phase_validation",
    "given_when_then_coverage_analysis",
    "test_design_quality_assessment",
    "scenario_mapping_verification",
    "test_structure_organization"
  ],
  "important_tasks": [
    "test_readability_review",
    "acceptance_criteria_mapping",
    "business_rule_testing_coverage",
    "error_scenario_validation",
    "test_data_management"
  ],
  "optional_tasks": [
    "test_performance_assessment",
    "mock_strategy_evaluation",
    "test_maintenance_considerations",
    "integration_test_design"
  ],
  "output_requirements": {
    "format": "structured_sections",
    "required_sections": [
      "実行サマリー",
      "総合判定", 
      "次のステップ"
    ],
    "critical_patterns": [
      "✅.*TDD REDフェーズ",
      "✅.*Given-When-Thenカバレッジ",
      "✅.*テスト設計品質",
      "(APPROVED|CONDITIONAL_APPROVAL|REJECTED)"
    ],
    "success_indicators": [
      "テスト設計レビュー完了",
      "TDD REDフェーズ評価",
      "全テストが適切に失敗",
      "シナリオカバレッジ.*100%"
    ],
    "failure_indicators": [
      "テストが通っている",
      "REDフェーズ違反",
      "カバレッジ不足",
      "テスト設計に問題"
    ]
  },
  "quality_gates": {
    "approved": {
      "description": "Ready for Domain Implementation",
      "criteria": [
        "All tests properly fail (RED phase)",
        "Complete Given-When-Then scenario coverage",
        "Test design quality meets standards",
        "Proper test structure and organization"
      ]
    },
    "conditional_approval": {
      "description": "Minor Test Improvements Needed",
      "criteria": [
        "Minor test improvements recommended",
        "Documentation enhancements needed", 
        "Core TDD principles followed"
      ]
    },
    "rejected": {
      "description": "Major Test Issues Require Fixes",
      "criteria": [
        "Tests are passing (not RED phase)",
        "Incomplete scenario coverage",
        "Poor test design quality"
      ]
    }
  },
  "next_steps": {
    "approved": "/implement-domain",
    "conditional_approval": "Apply improvements then /implement-domain",
    "rejected": "/create-tests (fix tests required)"
  },
  "retry_context": {
    "focus_areas": [
      "TDD RED phase compliance",
      "Given-When-Then scenario coverage",
      "Test design quality and readability", 
      "Business rule test coverage"
    ],
    "common_issues": [
      "Tests passing instead of failing",
      "Missing scenario coverage",
      "Poor test structure and naming",
      "Inadequate business rule testing"
    ]
  }
}
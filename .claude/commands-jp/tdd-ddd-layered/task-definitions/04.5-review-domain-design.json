{
  "command": "04.5-review-domain-design",
  "description": "Domain model design review for DDD compliance and architectural quality",
  "phase": "domain-design-review",
  "critical_tasks": [
    "ddd_compliance_check",
    "aggregate_boundary_validation", 
    "business_rules_placement",
    "entity_value_object_classification",
    "domain_integration_analysis"
  ],
  "important_tasks": [
    "entity_design_review",
    "value_object_validation",
    "repository_interface_design",
    "domain_service_assessment",
    "ubiquitous_language_consistency"
  ],
  "optional_tasks": [
    "performance_assessment",
    "documentation_quality",
    "extensibility_evaluation",
    "testability_assessment"
  ],
  "output_requirements": {
    "format": "structured_sections",
    "required_sections": [
      "実行サマリー", 
      "総合判定", 
      "次のステップ"
    ],
    "critical_patterns": [
      "✅.*DDD準拠性",
      "✅.*集約境界",
      "✅.*ビジネスルール配置",
      "(APPROVED|CONDITIONAL_APPROVAL|REJECTED)"
    ],
    "success_indicators": [
      "ドメイン設計レビュー完了",
      "DDD準拠性評価",
      "設計承認",
      "✅.*適切"
    ],
    "failure_indicators": [
      "DDD違反",
      "集約境界違反", 
      "設計修正が必要",
      "❌.*問題"
    ]
  },
  "quality_gates": {
    "approved": {
      "description": "Ready for TDD Implementation",
      "criteria": [
        "All DDD principles properly applied",
        "Aggregate boundaries clearly defined and respected",
        "Entity/Value Object classification accurate",
        "Business rules properly encapsulated"
      ]
    },
    "conditional_approval": {
      "description": "Minor Issues",
      "criteria": [
        "Minor design improvements recommended",
        "Documentation enhancements needed",
        "Core design principles followed"
      ]
    },
    "rejected": {
      "description": "Major Issues Require Redesign",
      "criteria": [
        "DDD principle violations detected",
        "Aggregate boundary problems identified",
        "Architectural inconsistencies found"
      ]
    }
  },
  "next_steps": {
    "approved": "/create-tests",
    "conditional_approval": "Apply improvements then /create-tests", 
    "rejected": "/domain-modeling (redesign required)"
  },
  "retry_context": {
    "focus_areas": [
      "DDD compliance validation",
      "Aggregate boundary design", 
      "Business rule encapsulation",
      "Integration consistency"
    ],
    "common_issues": [
      "Direct entity references across aggregates",
      "Business rules in wrong layer",
      "Inappropriate entity/value object classification"
    ]
  }
}
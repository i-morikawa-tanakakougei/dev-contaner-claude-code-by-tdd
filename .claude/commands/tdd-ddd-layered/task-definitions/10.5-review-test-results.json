    "success_indicators": [
      "テスト結果レビュー完了",
      "テスト成功率.*100%",
      "カバレッジ.*80%",
      "品質メトリクス.*良好"
    ],
    "failure_indicators": [
      "テストが失敗",
      "カバレッジ不足",
      "性能問題",
      "品質問題.*検出"
    ]
  },
  "quality_gates": {
    "approved": {
      "description": "Ready for Refactoring",
      "criteria": [
        "All tests passing with good success rate",
        "Adequate code coverage (80%+)",
        "Quality metrics within acceptable range",
        "Performance meets requirements"
      ]
    },
    "conditional_approval": {
      "description": "Minor Quality Issues",
      "criteria": [
        "Minor quality improvements recommended",
        "Coverage could be enhanced",
        "Performance acceptable with room for improvement"
      ]
    },
    "rejected": {
      "description": "Critical Issues Require Fixes",
      "criteria": [
        "Failing tests detected",
        "Insufficient code coverage",
        "Performance issues identified",
        "Quality metrics below standards"
      ]
    }
  },
  "next_steps": {
    "approved": "/refactor",

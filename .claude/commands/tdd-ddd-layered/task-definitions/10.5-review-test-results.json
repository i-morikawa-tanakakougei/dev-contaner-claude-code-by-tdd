  "output_requirements": {
    "format": "structured_sections",
    "required_sections": [
      "実行サマリー",
      "総合判定",
      "次のステップ"
    ],
    "critical_patterns": [
      "✅.*テスト実行結果",
      "✅.*カバレッジ分析",
      "✅.*品質メトリクス", 
      "(APPROVED|CONDITIONAL_APPROVAL|REJECTED)"

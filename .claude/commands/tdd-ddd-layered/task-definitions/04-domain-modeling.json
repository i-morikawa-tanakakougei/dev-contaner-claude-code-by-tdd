{
  "command": "04-domain-modeling",
  "description": "Design domain models for specific GitHub issue following DDD principles",
  "phase": "domain-modeling-phase",
  "category": "design",
  "priority": "high",
  "critical_tasks": [
    "use_case_specification_analysis",
    "entity_identification",
    "value_object_design",
    "aggregate_boundary_definition",
    "domain_service_identification",
    "repository_interface_design"
  ],
  "output_requirements": {
    "critical_patterns": [
      "✅.*ユースケース仕様.*分析",
      "✅.*エンティティ.*特定",
      "✅.*値オブジェクト.*設計",
      "✅.*集約境界.*定義",
      "✅.*ドメインサービス.*特定",
      "✅.*リポジトリ.*インターフェース設計",
      "(DOMAIN_MODEL_DESIGNED|ENTITIES_DEFINED|READY_FOR_REVIEW)"
    ],
    "required_sections": [
      "📊 実行サマリー",
      "📋 総合判定",
      "🏗️ ドメインモデル設計結果",
      "🎯 DDD構成要素確認",
      "➡️ 次のステップ"
    ],
    "success_indicators": [
      "ドメインモデル完成度",
      "DDD構成要素数",
      "集約境界明確性"
    ]
  },
  "prerequisites": [
    "use_case_specifications_complete",
    "given_when_then_scenarios_available",
    "domain_concepts_identified"
  ],
  "retry_context": {
    "common_issues": [
      "Unclear aggregate boundary definition",
      "Missing entity behavior identification",
      "Inadequate value object design",
      "Poor domain service responsibility assignment"
    ],
    "enhanced_guidance": [
      "DDD原則に基づく適切な集約境界とエンティティ設計",
      "ビジネスルールを適切に表現する値オブジェクトの設計",
      "複数エンティティにまたがるロジックのドメインサービス配置",
      "インフラ層との分離を保つリポジトリインターフェース設計"
    ],
    "special_focus": "ドメインモデルがビジネスルールを正確に表現し、TDD実装の基盤となることの確保"
  },
  "dependencies": {
    "previous_commands": ["03-create-use-case"],
    "next_commands": ["04.5-review-domain-design", "05-create-tests"],
    "required_files": [
      "docs/use_cases/issue-X-Y.md"
    ],
    "output_files": [
      "docs/domain/issue-X-Y.md"
    ]
  }

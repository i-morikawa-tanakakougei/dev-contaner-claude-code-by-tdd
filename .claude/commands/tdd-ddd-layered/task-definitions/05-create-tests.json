{
  "command": "05-create-tests",
  "description": "TDD RED phase implementation - create failing tests based on use case specifications",
  "phase": "tdd-red-phase",
  "category": "implementation",
  "priority": "high",
  "critical_tasks": [
    "specification_analysis",
    "domain_model_review", 
    "test_structure_design",
    "failing_test_implementation",
    "tdd_red_validation"
  ],
  "output_requirements": {
    "critical_patterns": [
      "✅.*仕様分析.*完了",
      "✅.*ドメインモデル.*確認",
      "✅.*テスト構造.*設計",
      "✅.*失敗テスト.*実装",
      "✅.*TDD RED.*検証",
      "(TESTS_CREATED|TESTS_FAILED_AS_EXPECTED|READY_FOR_IMPLEMENTATION)"
    ],
    "required_sections": [
      "📊 実行サマリー",
      "📋 総合判定", 
      "📁 作成テストファイル",
      "🔴 TDD RED状態確認",
      "➡️ 次のステップ"
    ],
    "success_indicators": [
      "テストファイル数",
      "カバレッジ確認",
      "全テスト失敗確認"
    ]
  },
  "prerequisites": [
    "use_case_specifications_exist",
    "domain_model_documented",
    "given_when_then_scenarios_complete"
  ],
  "retry_context": {
    "common_issues": [
      "Missing use case specifications in docs/use_cases/",
      "Incomplete domain model documentation",
      "Given-When-Then scenarios not well-defined",
      "Test framework setup issues"
    ],
    "enhanced_guidance": [
      "Given-When-Thenシナリオの完全なカバレッジを確保",
      "ドメインモデルとの整合性を厳密に確認",
      "TDD REDフェーズの確実な実行（全テスト失敗状態）",
      "テストの独立性とリピータビリティを保証"
    ],
    "special_focus": "TDD RED フェーズの原則に従った失敗テストの作成に集中し、実装コードは一切含めない"
  },
  "dependencies": {
    "previous_commands": ["03-create-use-case", "04-domain-modeling"],
    "next_commands": ["06-implement-domain"],
    "required_files": [
      "docs/use_cases/issue-X-Y.md",
      "docs/domain/issue-X-Y.md"
    ],
    "output_files": [
      "tests/unit/domain/test_*.py",
      "tests/unit/application/test_*.py", 
      "tests/integration/test_*.py"
    ]
  },
  "validation_rules": {
    "test_file_patterns": [
      "tests/.*test.*\\.py",
      "conftest\\.py"
    ],
    "content_validation": [
      "pytest.*framework",
      "Given.*When.*Then",
      "test.*fail.*expected"
    ],
    "structure_validation": [
      "tests/unit/domain/",
      "tests/unit/application/",
      "tests/integration/"
    ]
  }
}
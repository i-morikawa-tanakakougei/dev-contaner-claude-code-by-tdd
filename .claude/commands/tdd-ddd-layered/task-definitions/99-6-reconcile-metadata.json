      "✅.*プロジェクト状態.*分析.*完了",
      "✅.*メタデータ.*整合性.*検証.*完了",
      "✅.*復旧進捗.*同期.*完了",
      "✅.*スコープ.*調整.*完了",
      "✅.*整合性検証.*完了",
      "✅.*調整記録.*完了",
      "(METADATA_CONSISTENT|RECOVERY_STATUS_UPDATED|READY_FOR_FINAL_REVIEW)"
    ],
    "required_sections": [
      "📊 実行サマリー",
      "📋 総合判定",
      "📊 調整結果",
      "🔄 メタデータ更新適用",
      "📈 プロジェクト状態サマリー",
      "➡️ 次のステップ"
    ],
    "success_indicators": [
      "調整されたファイル数",
      "解決された不整合数",
      "整合性スコア"
    ]
  },
  "prerequisites": [
    "emergency_fix_validated",
    "metadata_files_available",
    "recovery_steps_completed"
  ],
  "retry_context": {
    "common_issues": [
      "Metadata files not found",
      "Inconsistent metadata state",
      "Metadata corruption",
      "JSON syntax errors"
    ],
    "enhanced_guidance": [
      "プロジェクトメタデータ構造の確認と不足ファイルの初期化",
      "複数メタデータファイル間の競合解決と優先順位付け",
      "メタデータバックアップからの復旧手順の実施",
      "JSON構文エラーの特定と修正による整合性確保"
    ],
    "special_focus": "すべてのメタデータファイルの完全な整合性確保と将来の一貫性維持"
  },
  "dependencies": {
    "previous_commands": ["99-5-validate-emergency-fix"],
    "next_commands": ["99-7-review-emergency-recovery"],
    "required_files": [
      "docs/metadata/project-state.json",
      ".claude/context/project-context.json",
      ".claude/context/execution-history.jsonl"
    ],
    "output_files": [
      "docs/metadata/project-state.json (updated)",
      ".claude/context/project-context.json (updated)",
      "metadata-reconciliation-report.md"
    ]
  },
  "metadata_integration": {
    "project_state_updates": {
      "metadata_status": {
        "last_reconciliation_timestamp": "CURRENT_TIMESTAMP",
        "reconciliation_scope": "RECONCILIATION_SCOPE",

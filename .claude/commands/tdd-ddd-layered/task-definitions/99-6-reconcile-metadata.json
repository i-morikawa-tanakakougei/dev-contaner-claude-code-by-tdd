{
  "command": "99-6-reconcile-metadata",
  "description": "Comprehensive metadata reconciliation and synchronization after emergency recovery process completion",
  "phase": "metadata-reconciliation-phase",
  "category": "emergency-recovery",
  "priority": "medium",
  "version": "1.0",
  "last_updated": null,
  "required_subagent": "99-6-reconcile-metadata",

    "system_integration_updates": {
      "metadata_management_metrics": {
        "reconciliation_sessions": "INCREMENT_BY_1",
        "consistency_improvements": "TRACK_CONSISTENCY_GAINS"
      }
    }
  },
  "execution_requirements": {
    "context_files_required": [
      ".claude/context/current-command-context.json",
      ".claude/context/project-context.json",
      "docs/metadata/project-state.json"
    ],
    "subagent_invocation": {
      "agent_name": "99-6-reconcile-metadata",
      "agent_mandatory": true,
      "fallback_behavior": "error_with_guidance"
    },
    "post_execution_updates": [
      "update_metadata_consistency_status",
      "sync_all_metadata_files",
      "prepare_final_review_context"
    ]
  },
  "command_parameters": {
    "scope": {
      "type": "string",
      "values": ["project", "sprint", "issue"],
      "default": "issue",
      "description": "Scope of metadata reconciliation"
    },
    "validate_json": {
      "type": "boolean",
      "default": true,
      "description": "Validate JSON syntax after reconciliation"
    },
    "backup": {
      "type": "boolean",
      "default": true,
      "description": "Create backup before reconciliation"
    }
  }
}